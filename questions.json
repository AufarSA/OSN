  {"id":"al-008","mode":"mental","topic":"Aljabar","difficulty":"Medium","type":"multiple","question":"Jika a = −2, maka nilai a³ + a² adalah ...","options":["−4","4","−12","12"],"answer":"−4","explanation":"(−2)³ = −8 dan (−2)² = 4, sehingga −8 + 4 = −4.","timeMultiplier":1.0,"tags":["pangkat","substitusi"]},
