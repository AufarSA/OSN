[
  {"id":"ar-001","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Hasil dari 48 + 37 adalah ...","options":["75","85","95","84"],"answer":"85","explanation":"48 + 37 = 48 + 40 − 3 = 85.","timeMultiplier":0.7,"tags":["penjumlahan"]},
  {"id":"ar-002","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"numeric","question":"Hasil dari 125 × 8 adalah ...","answer":"1000","explanation":"125 × 8 = 1000 (ingat 1/8 dari 1000 = 125).","timeMultiplier":0.7,"tags":["perkalian"]},
  {"id":"ar-003","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"numeric","question":"15% dari 240 adalah ...","answer":"36","explanation":"10% = 24, 5% = 12, jadi 15% = 24 + 12 = 36.","timeMultiplier":0.8,"tags":["persen"]},
  {"id":"ar-004","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Hasil dari 3/4 + 5/8 adalah ...","options":["8/12","11/8","9/8","7/8"],"answer":"11/8","explanation":"3/4 = 6/8, sehingga 6/8 + 5/8 = 11/8.","timeMultiplier":0.8,"tags":["pecahan"]},
  {"id":"ar-005","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"numeric","question":"Hasil dari 25 × 36 adalah ...","answer":"900","explanation":"25 × 36 = 100 × 9 = 900 (25 × 4 = 100, 36 = 4 × 9).","timeMultiplier":0.8,"tags":["perkalian","trik"]},
  {"id":"ar-006","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"Hasil dari 99 × 17 adalah ...","answer":"1683","explanation":"99 × 17 = 100 × 17 − 17 = 1700 − 17 = 1683.","timeMultiplier":1.0,"tags":["perkalian","trik"]},
  {"id":"ar-007","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Hasil dari 1,5 × 0,4 adalah ...","options":["0,06","0,6","6","0,15"],"answer":"0,6","explanation":"15 × 4 = 60, dua angka di belakang koma sehingga 0,60 = 0,6.","timeMultiplier":0.8,"tags":["desimal"]},
  {"id":"ar-008","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"numeric","question":"2/5 dari 350 adalah ...","answer":"140","explanation":"1/5 dari 350 = 70, jadi 2/5 = 140.","timeMultiplier":0.8,"tags":["pecahan"]},
  {"id":"ar-009","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Hasil dari 1000 − 487 adalah ...","options":["523","513","413","563"],"answer":"513","explanation":"1000 − 487 = 999 − 487 + 1 = 512 + 1 = 513.","timeMultiplier":0.7,"tags":["pengurangan"]},
  {"id":"ar-010","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"Hasil dari 72 : 0,6 adalah ...","answer":"120","explanation":"72 : 0,6 = 720 : 6 = 120.","timeMultiplier":1.0,"tags":["desimal","pembagian"]},
  {"id":"ar-011","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"multiple","question":"Nilai dari 17² adalah ...","options":["279","289","299","269"],"answer":"289","explanation":"17² = (20 − 3)² = 400 − 120 + 9 = 289.","timeMultiplier":1.0,"tags":["kuadrat"]},
  {"id":"ar-012","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"Hasil dari 45 × 22 adalah ...","answer":"990","explanation":"45 × 22 = 45 × 20 + 45 × 2 = 900 + 90 = 990.","timeMultiplier":1.0,"tags":["perkalian"]},
  {"id":"ar-013","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Sebuah buku seharga Rp80.000 mendapat diskon 25%. Harga yang dibayar adalah ...","options":["Rp55.000","Rp60.000","Rp65.000","Rp70.000"],"answer":"Rp60.000","explanation":"25% dari 80.000 = 20.000, sehingga 80.000 − 20.000 = 60.000.","timeMultiplier":0.8,"tags":["persen","diskon"]},
  {"id":"ar-014","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"Hasil dari 2,5 × 4,4 adalah ...","answer":"11","explanation":"2,5 × 4,4 = 2,5 × 4 × 1,1 = 10 × 1,1 = 11.","timeMultiplier":1.0,"tags":["desimal","perkalian"]},
  {"id":"ar-015","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"multiple","question":"Hasil dari 3/5 : 3/10 adalah ...","options":["1/2","2","9/50","3"],"answer":"2","explanation":"3/5 × 10/3 = 10/5 = 2.","timeMultiplier":1.0,"tags":["pecahan","pembagian"]},
  {"id":"ar-016","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"Hasil dari 998 + 997 + 5 adalah ...","answer":"2000","explanation":"998 + 997 = 1995, ditambah 5 menjadi 2000.","timeMultiplier":0.9,"tags":["penjumlahan","trik"]},
  {"id":"ar-017","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"Hasil dari 31 × 29 adalah ...","answer":"899","explanation":"31 × 29 = (30 + 1)(30 − 1) = 900 − 1 = 899.","timeMultiplier":1.0,"tags":["perkalian","selisih kuadrat"]},
  {"id":"ar-018","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Bentuk pecahan paling sederhana dari 0,125 adalah ...","options":["1/4","1/5","1/8","1/12"],"answer":"1/8","explanation":"0,125 = 125/1000 = 1/8.","timeMultiplier":0.7,"tags":["desimal","pecahan"]},
  {"id":"ar-019","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Hasil dari 1/2 + 1/3 + 1/6 adalah ...","options":["1","5/6","1/2","11/12"],"answer":"1","explanation":"Samakan penyebut 6: 3/6 + 2/6 + 1/6 = 6/6 = 1.","timeMultiplier":0.8,"tags":["pecahan"]},
  {"id":"ar-020","mode":"mental","topic":"Aritmetika","difficulty":"Medium","type":"numeric","question":"64% dari 250 adalah ...","answer":"160","explanation":"250 = 1/4 dari 1000, jadi 64% × 250 = 0,64 × 250 = 160.","timeMultiplier":1.0,"tags":["persen"]},
  {"id":"ar-021","mode":"mental","topic":"Aritmetika","difficulty":"Easy","type":"multiple","question":"Hasil dari 7/8 − 3/4 adalah ...","options":["4/4","1/8","1/4","4/8"],"answer":"1/8","explanation":"3/4 = 6/8, sehingga 7/8 − 6/8 = 1/8.","timeMultiplier":0.8,"tags":["pecahan"]},
