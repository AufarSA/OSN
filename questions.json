  {"id":"ge-005","mode":"mental","topic":"Geometri","difficulty":"Easy","type":"multiple","question":"Jumlah besar sudut dalam segi enam adalah ...","options":["540°","720°","900°","360°"],"answer":"720°","explanation":"(6 − 2) × 180° = 720°.","timeMultiplier":0.8,"tags":["sudut","segi-n"]},
  {"id":"ge-006","mode":"mental","topic":"Geometri","difficulty":"Easy","type":"numeric","question":"Luas lingkaran berjari-jari 7 cm (π = 22/7) adalah ... cm²","answer":"154","explanation":"22/7 × 7 × 7 = 22 × 7 = 154.","timeMultiplier":0.8,"tags":["luas","lingkaran"]},
